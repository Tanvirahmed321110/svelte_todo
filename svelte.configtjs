// vite.config.ts
import { sveltekit } from '@sveltejs/kit/vite';
import adapter from '@sveltejs/adapter-static';
import { defineConfig } from 'vite';

export default defineConfig({
    plugins: [
        sveltekit({
            adapter: adapter({
                pages: 'build',
                assets: 'build',
                fallback: '200.html', // Surge-এর SPA রাউটিংয়ের জন্য
                precompress: false
            })
        })
    ]
});
